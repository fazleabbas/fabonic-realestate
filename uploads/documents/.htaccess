# FIS Real Estate — direct access denied.
# Files here hold tenant PII and documents; they are served only through
# api/file.php, which enforces session, permission and property scope.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
Options -Indexes
